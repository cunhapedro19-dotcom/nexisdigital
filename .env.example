# ===========================================================
# Nexis Digital — variáveis de ambiente
# Copie este arquivo para ".env.local" e preencha os valores.
# ===========================================================

# WhatsApp comercial em formato internacional, SEM "+" e SEM espaços.
# Ex.: 5511987654321
# Enquanto estiver vazio, os botões de WhatsApp do site usam o e-mail
# como canal de contato automaticamente.
NEXT_PUBLIC_WHATSAPP=

# URL pública final do site, COM https e SEM barra final.
# GitHub Pages: https://SEU-USUARIO.github.io/nexisdigital
# Domínio próprio: https://nexisdigital.com.br
NEXT_PUBLIC_SITE_URL=https://nexisdigital.com.br
