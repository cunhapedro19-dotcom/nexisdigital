{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@nexis/ui/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "tailwind.config.ts", "postcss.config.js"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx"]
}