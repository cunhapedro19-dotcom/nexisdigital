{
  "name": "nexis-digital",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:pages": "node scripts/build-pages.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze": "ANALYZE=true next build",
    "dev:platform": "turbo run dev --filter=@nexis/platform",
    "dev:tenant": "turbo run dev --filter=@nexis/tenant-app",
    "build:platform": "turbo run build --filter=@nexis/platform",
    "build:tenant": "turbo run build --filter=@nexis/tenant-app",
    "monorepo:build": "turbo run build",
    "monorepo:lint": "turbo run lint",
    "monorepo:typecheck": "turbo run typecheck",
    "monorepo:test": "turbo run test",
    "db:generate": "turbo run db:generate --filter=@nexis/db",
    "db:push": "turbo run db:push --filter=@nexis/db",
    "db:studio": "turbo run db:studio --filter=@nexis/db",
    "plugins:build": "turbo run build --filter=@nexis/plugin-*",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^24.0.0",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vitest": "^2.0.0",
    "turbo": "^2.0.0",
    "prettier": "^3.0.0",
    "@changesets/cli": "^2.27.0"
  },
  "packageManager": "npm@10.8.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
