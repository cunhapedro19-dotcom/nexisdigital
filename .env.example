# Database
DATABASE_URL="postgresql://user:password@localhost:5432/nexis?schema=public"
# Ou para Neon/Supabase:
# DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/nexis?sslmode=require"

# Auth
NEXTAUTH_SECRET="gere-com-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Platform
PLATFORM_DOMAIN="localhost:3000"
PLATFORM_NAME="Nexis Digital"

# Stripe (Billing)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Mercado Pago (Billing BR)
MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."
MERCADOPAGO_PUBLIC_KEY="APP_USR-..."
MERCADOPAGO_WEBHOOK_SECRET="..."

# Storage (S3/R2)
S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="..."
S3_SECRET_ACCESS_KEY="..."
S3_BUCKET="nexis-assets"
S3_PUBLIC_URL="https://assets.nexisdigital.com.br"

# Redis (Upstash - sessões, cache, rate limit)
REDIS_URL="redis://localhost:6379"
# Ou Upstash:
# REDIS_URL="rediss://default:xxx@xxx.upstash.io:6379"

# Email (Resend / SendGrid / Nodemailer)
EMAIL_FROM="Nexis Digital <noreply@nexisdigital.com.br>"
RESEND_API_KEY="re_..."

# Analytics / Monitoring
SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"